# ============================================================================
# Offera AI — environment variables
#
# Copy to .env.local and fill in. Never commit .env.local.
#   cp .env.example .env.local
# ============================================================================


# ---------------------------------------------------------------------------
# Supabase (required)
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
# Both are NEXT_PUBLIC_ and therefore visible in the browser. That is correct:
# the anon key is designed to be public and is only safe because Row Level
# Security restricts what it can reach. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key


# ---------------------------------------------------------------------------
# Site URL (required)
# ---------------------------------------------------------------------------
# Base URL used to build the redirect targets in confirmation and password
# reset emails. Must match the deployed origin exactly, with no trailing slash,
# or those links will point at the wrong host.
#   local:      http://localhost:3000
#   production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# OpenRouter (required for the AI tools)
# https://openrouter.ai/keys
# ---------------------------------------------------------------------------
# Server-side only — deliberately NOT prefixed with NEXT_PUBLIC_, so it is
# never bundled into client JavaScript. Used by app/api/ai/route.ts, which
# calls the `openrouter/free` router.
OPENROUTER_API_KEY=your_openrouter_key


# ---------------------------------------------------------------------------
# Upstash Redis (optional, recommended for serverless deployments)
# https://console.upstash.com — free tier, no credit card
# ---------------------------------------------------------------------------
# Without these, rate limiting falls back to an in-memory store. That is
# correct for a single long-lived process (Docker, `node server.js`, local dev)
# but NOT for serverless: on Vercel every instance keeps its own counters, so
# the effective limit becomes (limit x instance count) and a cold start resets
# the failed-login lockout.
#
# Set both to make limits and lockouts hold across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
